# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Datasets: ignore everything under data/ except the small ready-to-run infrared
# night-vision dataset, which is committed so the repo works straight after clone.
data/*
!data/.gitkeep
!data/night_wildlife/
.cct_cache/

# Training artifacts
*.pt
*.pth
checkpoints/

# Results are regenerated by the scripts; keep the folder, ignore heavy outputs
results/*
!results/.gitkeep
!results/README.md

# OS / editor
.DS_Store
.idea/
.vscode/
